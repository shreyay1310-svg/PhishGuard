# PhishGuard Backend Environment Configuration
PORT=5050
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Microsoft SQL Server Production Configuration
DB_SERVER=your-sql-server-host.database.windows.net
DB_PORT=1433
DB_NAME=PhishGuardDB
DB_DATABASE=PhishGuardDB
DB_USER=phishguard_admin
DB_PASSWORD=YourStrongPasswordHere!
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Python FastAPI AI/ML Microservice URL
ML_SERVICE_URL=http://localhost:8008
ML_API_URL=http://localhost:8008
